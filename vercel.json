{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix outputs run build",
  "outputDirectory": "outputs",
  "functions": {
    "outputs/api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/outputs/api/:path*"
    }
  ]
}
